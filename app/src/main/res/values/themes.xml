<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.PoswalNoor" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ SplashScreen Theme -->
    <style name="Theme.PoswalNoor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#064E3B</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PoswalNoor</item>
    </style>
</resources>
